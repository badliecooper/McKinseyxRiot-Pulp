import React, { useState, useEffect } from "react";
import { NavLink, Outlet, useLocation } from "react-router-dom";
import { 
  Activity, 
  MapPin, 
  GitCompare, 
  Bot, 
  Clock, 
  Database,
  Cpu,
  Layers,
  Upload
} from "lucide-react";
import { api } from "../api/client";
import { NotificationBell } from "./NotificationBell";
import { UploadModal } from "./UploadModal";

export const Layout: React.FC = () => {
  const [operatingMode, setOperatingMode] = useState<string>("Rule-based mode");
  const [lastRefreshed, setLastRefreshed] = useState<string>("");
  const [uploadOpen, setUploadOpen] = useState<boolean>(false);
  const location = useLocation();

  useEffect(() => {
    api.getHealth()
      .then((res) => {
        setOperatingMode(res.operating_mode === "DETERMINISTIC_FALLBACK_ENGINE" ? "Rule-based mode" : res.operating_mode);
        setLastRefreshed(new Date().toLocaleTimeString("en-IN", { hour12: false }) + " IST");
      })
      .catch(() => {
        setOperatingMode("Rule-based mode");
        setLastRefreshed("OFFLINE");
      });
  }, [location.pathname]);

  const navItems = [
    { to: "/control-tower", label: "Control Tower", badge: "Grid", icon: Activity },
    { to: "/depot-explorer", label: "Depot Explorer", badge: "45 SKU-Depots", icon: MapPin },
    { to: "/scenario-replay", label: "Scenario Replay", badge: "Interventions", icon: GitCompare },
    { to: "/ai-copilot", label: "AI Copilot & Approval", badge: "Governed IBP", icon: Bot },
  ];

  return (
    <div className="flex h-screen w-screen overflow-hidden bg-cohere-bg font-sans text-cohere-textPrimary antialiased selection:bg-cohere-actionBlue selection:text-white">
      {/* PERSISTENT LEFT SIDEBAR (Cohere Sovereign Shell) */}
      <aside className="w-64 flex-shrink-0 flex flex-col border-r border-cohere-border bg-cohere-panel select-none">
        {/* Brand Header */}
        <div className="p-4 border-b border-cohere-border bg-cohere-panel">
          <div className="flex items-center space-x-2">
            <span className="font-mono font-bold text-[11px] tracking-widest text-white uppercase bg-cohere-surface px-2.5 py-1 rounded-xs border border-cohere-borderLight">
              [PULP RIOT]
            </span>
          </div>
          <div className="mt-2 text-sm font-semibold text-white tracking-tight flex items-center justify-between">
            <span>Pulp Riot Juice Co.</span>
            <span className="w-2 h-2 rounded-full bg-scm-healthy" title="System Live"></span>
          </div>
          <div className="text-[11px] text-cohere-textMuted mt-0.5">Supply Chain Control Tower</div>
        </div>

        {/* Navigation Links */}
        <nav className="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
          <div className="px-2 pb-2 text-[10px] font-mono font-medium tracking-widest text-cohere-muted uppercase">
            OPERATIONAL VIEWS
          </div>
          {navItems.map((item) => {
            const Icon = item.icon;
            const isActive = location.pathname === item.to || (item.to === "/control-tower" && location.pathname === "/");
            return (
              <NavLink
                key={item.to}
                to={item.to}
                className={`flex items-center justify-between px-3 py-2 rounded-xs text-xs transition-colors duration-100 ${
                  isActive
                    ? "bg-cohere-surface text-white border-l-2 border-white font-semibold"
                    : "text-cohere-textSecondary hover:bg-cohere-surface/40 hover:text-white font-normal"
                }`}
              >
                <div className="flex items-center space-x-2.5">
                  <Icon className={`w-3.5 h-3.5 ${isActive ? "text-white" : "text-cohere-textMuted"}`} />
                  <span>{item.label}</span>
                </div>
                <span className={`text-[9.5px] font-mono px-1.5 py-0.5 rounded-xs ${
                  isActive 
                    ? "bg-white/10 text-white border border-white/20" 
                    : "text-cohere-muted"
                }`}>
                  {item.badge}
                </span>
              </NavLink>
            );
          })}
        </nav>

        {/* Executive Case Facts Box (Mineral Flat Card) */}
        <div className="p-3.5 m-3 rounded-sm bg-cohere-card border border-cohere-border text-[11px] space-y-1.5 leading-snug">
          <div className="font-mono font-medium text-cohere-muted uppercase tracking-wider text-[9.5px] flex items-center justify-between pb-1 border-b border-cohere-border/60">
            <span>Case Facts Baseline</span>
            <Layers className="w-3 h-3 text-cohere-muted" />
          </div>
          <div className="text-cohere-textSecondary flex justify-between pt-0.5">
            <span>Annual Revenue:</span> <span className="font-mono font-medium text-white">₹1,200 Cr</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>Contribution Margin:</span> <span className="font-mono font-medium text-white">32.0%</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>Summer Finished Vol:</span> <span className="font-mono font-medium text-white">9.6 Cr btls</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>Target Inventory Cover:</span> <span className="font-mono font-medium text-scm-healthy">21 Days</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>Transfer Freight Cost:</span> <span className="font-mono font-medium text-white">₹1.50 / btl</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>MT/QC Rejection Gate:</span> <span className="font-mono font-medium text-scm-warning">&lt; 60 Days</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between">
            <span>Near-Cliff Warning:</span> <span className="font-mono font-medium text-scm-warning">67 Days</span>
          </div>
          <div className="text-cohere-textSecondary flex justify-between pt-1 border-t border-cohere-border/60">
            <span>Year-1 Budget Hurdle:</span> <span className="font-mono font-semibold text-cohere-actionBlue">₹2.50 Cr (10.4%)</span>
          </div>
        </div>

        {/* Data Disclaimer Footer */}
        <div className="p-2.5 border-t border-cohere-border bg-cohere-panel text-[9px] text-cohere-muted text-center font-mono tracking-wider uppercase">
          SYNTHETIC DEMO CALIBRATED
        </div>
      </aside>

      {/* MAIN CONTENT AREA */}
      <div className="flex-1 flex flex-col min-w-0 overflow-hidden bg-cohere-bg">
        {/* Top Header Bar */}
        <header className="h-12 flex-shrink-0 border-b border-cohere-border bg-cohere-panel px-5 flex items-center justify-between">
          <div className="flex items-center space-x-3 text-xs">
            <span className="font-mono font-medium uppercase tracking-wider text-cohere-muted text-[10.5px]">
              OPERATIONS STATUS:
            </span>
            <span className="badge-ok flex items-center space-x-1">
              <span className="w-1.5 h-1.5 rounded-full bg-scm-healthy inline-block"></span>
              <span>[ACTIVE]</span>
            </span>
            <span className="text-cohere-border">|</span>
            <div className="flex items-center space-x-1.5 text-cohere-textSecondary text-[11px]">
              <Cpu className="w-3.5 h-3.5 text-cohere-muted" />
              <span>Engine:</span>
              <span className="badge-gold">
                [{operatingMode}]
              </span>
            </div>
          </div>

          <div className="flex items-center space-x-3 text-xs text-cohere-textMuted">
            {/* Upload Data Button for Planning Team (Cohere Primary Button) */}
            <button
              onClick={() => setUploadOpen(true)}
              className="button-primary text-xs"
              title="Upload daily Modern Trade / Quick Commerce sales CSV"
            >
              <Upload className="w-3 h-3 text-cohere-black" />
              <span>Upload Data</span>
            </button>

            {/* Notification Bell */}
            <NotificationBell />

            <span className="text-cohere-border">|</span>

            <div className="flex items-center space-x-1 font-mono text-[11px] text-cohere-textSecondary hidden sm:flex">
              <Clock className="w-3.5 h-3.5 text-cohere-muted" />
              <span>Refreshed:</span>
              <span className="text-white font-medium">{lastRefreshed}</span>
            </div>
            <span className="text-cohere-border hidden sm:inline">|</span>
            <div className="flex items-center space-x-1 text-cohere-textMuted font-mono text-[10.5px] hidden md:flex">
              <Database className="w-3.5 h-3.5 text-cohere-muted" />
              <span>CSV PERSISTENCE</span>
            </div>
          </div>
        </header>

        {/* Content Outlet */}
        <main className="flex-1 overflow-y-auto p-4 md:p-6 space-y-4">
          <Outlet />
        </main>

        {/* Daily Data Upload Modal */}
        <UploadModal 
          isOpen={uploadOpen} 
          onClose={() => setUploadOpen(false)} 
          onUploadSuccess={() => window.location.reload()} 
        />
      </div>
    </div>
  );
};
