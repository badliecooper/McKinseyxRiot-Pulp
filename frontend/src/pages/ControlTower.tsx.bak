                      <div>
                        <div className="text-[10px] font-mono uppercase text-cohere-muted">National WAPE</div>
                        <div className="text-xl font-bold font-mono text-white mt-0.5">
                          {forecastAccuracy?.national_panel.wape_pct ?? "10.7"}%
                        </div>
                        <div className="text-[9.5px] font-mono text-scm-healthy">High aggregate accuracy</div>
                      </div>
                      <div>
                        <div className="text-[10px] font-mono uppercase text-cohere-muted">National Bias</div>
                        <div className={`text-xl font-bold font-mono mt-0.5 ${(forecastAccuracy?.national_panel.bias_pct ?? -10.7) < 0 ? "text-scm-critical" : "text-scm-warning"}`}>
                          {forecastAccuracy?.national_panel.bias_pct ?? "-10.7"}%
                        </div>
                        <div className="text-[9.5px] font-mono text-scm-critical">
                          [{forecastAccuracy?.national_panel.bias_direction ?? "UNDERFORECASTING"}]
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* SKU-DEPOT PANEL */}
                  <div className="p-3 rounded-xs bg-cohere-panel/50 border border-cohere-border space-y-2">
                    <div className="flex items-center justify-between border-b border-cohere-border/60 pb-1.5">
                      <span className="font-mono text-xs font-semibold text-white uppercase tracking-wider">
                        SKU–Depot Panel (Disaggregated)
                      </span>
                      <span className="badge-critical">[45 LOCAL CELLS]</span>
                    </div>
                    <div className="grid grid-cols-2 gap-3 pt-1">
                      <div>
                        <div className="text-[10px] font-mono uppercase text-cohere-muted">SKU–Depot WAPE</div>
                        <div className="text-xl font-bold font-mono text-white mt-0.5">
                          {forecastAccuracy?.sku_depot_panel.wape_pct ?? "12.2"}%
                        </div>
                        <div className="text-[9.5px] font-mono text-cohere-muted">Cell-level error metric</div>
                      </div>
                      <div>
                        <div className="text-[10px] font-mono uppercase text-cohere-muted">Mean Absolute Bias</div>
                        <div className="text-xl font-bold font-mono text-cohere-actionBlue mt-0.5">
                          {forecastAccuracy?.sku_depot_panel.mean_absolute_bias_pct ?? "12.2"}%
                        </div>
                        <div className="text-[9.5px] font-mono text-scm-warning">
                          Σ|bias_s,d| / N (Uncancelling)
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Side-by-Side Chart & Explanatory Callout */}
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 pt-1">
                  <div className="lg:col-span-2 p-2.5 rounded-xs bg-cohere-panel/40 border border-cohere-border">
                    <div className="text-[11px] font-mono font-medium text-white uppercase mb-1">
                      Side-by-Side Macro vs Micro Error Metrics
                    </div>
                    <div className="h-48 w-full">
                      <EChart option={nationalVsLocalForecastOption} height={180} />
                    </div>
                  </div>

                  {/* Aggregation Fallacy Explanation */}
                  <div className="p-3 rounded-xs bg-cohere-panel/40 border border-cohere-border flex flex-col justify-between space-y-2">
                    <div className="space-y-1.5">
                      <div className="text-[11px] font-mono font-semibold text-scm-warning uppercase tracking-wide">
                        [WHY NATIONAL BIAS MISLEADS]
                      </div>
                      <p className="text-[11px] text-cohere-textMuted leading-relaxed">
                        National forecast errors cancel out across depots and SKUs. For instance, surplus stock in Bangalore masks acute stock-outs in Delhi. A low national bias does not indicate accurate local forecasts.
                      </p>
                      <div className="p-2 rounded-xs bg-cohere-card border border-cohere-border text-[10.5px] font-mono space-y-1">
                        <div className="text-cohere-muted">MASKED ERROR GAP:</div>
                        <div className="text-white font-bold text-sm">
                          +{forecastAccuracy?.sku_depot_panel.cancelling_error_gap_pct ?? "1.5"}% Cancelling Gap
                        </div>
                        <div className="text-[9.5px] text-cohere-muted">
                          Local absolute bias exceeds aggregate bias due to regional misallocation.
                        </div>
                      </div>
                    </div>
                    <div className="text-[9px] font-mono text-cohere-muted">
                      Note: Synthetic demo constructs calibrated to case constraints. Negative bias = underforecasting.
                    </div>
                  </div>
                </div>

                {/* Per-Flavor Breakdown Grid */}
                {forecastAccuracy?.sku_breakdown && (
                  <div className="overflow-x-auto border border-cohere-border rounded-xs">
                    <table className="w-full text-left border-collapse text-[11px] font-mono">
                      <thead>
                        <tr className="bg-cohere-surface/80 text-cohere-muted border-b border-cohere-border text-[10px] uppercase">
                          <th className="py-1.5 px-3">SKU</th>
                          <th className="py-1.5 px-3">Flavour Name</th>
                          <th className="py-1.5 px-3 text-right">National WAPE</th>
                          <th className="py-1.5 px-3 text-right">National Bias</th>
                          <th className="py-1.5 px-3 text-right">Local Mean |Bias|</th>
                          <th className="py-1.5 px-3 text-right">Cancelling Gap</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-cohere-border/50 text-white">
                        {forecastAccuracy.sku_breakdown.map((row) => (
                          <tr key={row.sku_id} className="hover:bg-cohere-surface/30">
                            <td className="py-1.5 px-3 font-semibold text-cohere-actionBlue">{row.sku_id}</td>
                            <td className="py-1.5 px-3 text-cohere-textMuted">{row.flavour}</td>
                            <td className="py-1.5 px-3 text-right">{row.national_wape_pct}%</td>
                            <td className={`py-1.5 px-3 text-right font-semibold ${row.national_bias_pct < 0 ? "text-scm-critical" : "text-scm-warning"}`}>
                              {row.national_bias_pct > 0 ? `+${row.national_bias_pct}%` : `${row.national_bias_pct}%`}
                            </td>
                            <td className="py-1.5 px-3 text-right text-cohere-actionBlue font-semibold">{row.mean_abs_depot_bias_pct}%</td>
                            <td className="py-1.5 px-3 text-right text-scm-warning font-mono">
                              +{row.cancelling_gap_pct}%
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {/* CHART 5: FORECAST ACCURACY BENCHMARK */}
                <div className="p-3 rounded-xs bg-cohere-card border border-cohere-border space-y-1.5">
                  <div className="text-[11px] font-mono font-medium text-white uppercase">
                    Chart 5 — Forecast Accuracy Benchmark (WAPE %)
                  </div>
                  <div className="text-[10px] text-cohere-textMuted">RIOT RADAR vs Naive Last-Week Actuals</div>
                  <div className="h-48 w-full">
                    <EChart option={forecastAccuracyOption} height={190} />
                  </div>
                </div>

                {/* CHART 6: FORECAST ERROR AND BIAS OVER TIME */}
                <div className="p-3 rounded-xs bg-cohere-card border border-cohere-border space-y-1.5">
                  <div className="text-[11px] font-mono font-medium text-white uppercase">
                    Chart 6 — Forecast Error &amp; Bias Trajectory
                  </div>
                  <div className="text-[10px] text-cohere-textMuted">WAPE % (Blue) &amp; Bias % (Teal Dashed) across vintages</div>
                  <div className="h-48 w-full">
                    <EChart option={forecastErrorTrendOption} height={190} />
                  </div>
                </div>
              </div>

              {/* REPORT PREVIEW AND DOWNLOAD ACTION */}
              <div className="p-3.5 rounded-xs bg-cohere-card border border-cohere-border flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <div className="space-y-1">
                  <div className="text-xs font-semibold text-white flex items-center space-x-2">
                    <FileText className="w-4 h-4 text-cohere-actionBlue" />
                    <span>Weekly Intelligence Briefing — Week 2026-W18</span>
                    <span className="badge-ok">VERIFIED 3-PAGE CEILING</span>
                  </div>
                  <p className="text-[11.5px] text-cohere-textMuted">
                    {reportPreview?.executive_summary || "Multi-echelon exception briefing with automated ReportLab/Matplotlib charts and root-cause loss attribution."}
                  </p>
                </div>

                <button
                  onClick={handleDownloadReport}
                  disabled={generatingReport}
                  className="button-primary flex-shrink-0"
                >
                  <Download className="w-3.5 h-3.5" />
                  <span>{generatingReport ? "Generating PDF..." : "Download 3-Page Executive PDF"}</span>
                </button>
              </div>
            </div>
          )}
        </div>
      </section>

      {/* ALARM DETAIL MODAL */}
      {selectedAlarm && (
        <div className="fixed inset-0 bg-black/75 flex items-center justify-center p-4 z-50">
          <div className="bg-cohere-card border border-cohere-border rounded-md max-w-lg w-full p-5 space-y-4 shadow-card-elevated">
            <div className="flex items-center justify-between border-b border-cohere-border pb-2.5">
              <div className="flex items-center space-x-2">
                <span className={selectedAlarm.severity === "CRITICAL" ? "badge-critical" : "badge-warn"}>
                  [{selectedAlarm.severity}]
                </span>
                <span className="font-mono font-semibold text-sm text-white">{selectedAlarm.alarm_id}</span>
              </div>
              <button 
                onClick={() => setSelectedAlarm(null)}
                className="text-cohere-muted hover:text-white text-sm font-bold"
              >
                ✕
              </button>
            </div>

            <div className="space-y-2 text-xs">
              <div>
                <div className="font-semibold text-white text-sm">{selectedAlarm.title}</div>
                <div className="text-cohere-textMuted mt-1">{selectedAlarm.description}</div>
              </div>

              <div className="grid grid-cols-2 gap-2 p-2.5 rounded-xs bg-cohere-panel border border-cohere-border font-mono text-[11px]">
                <div>SKU: <span className="text-cohere-actionBlue font-medium">{selectedAlarm.sku_id}</span></div>
                <div>Depot: <span className="text-white font-medium">{selectedAlarm.depot_id}</span></div>
                <div>Observed: <span className="text-scm-critical">{selectedAlarm.observed_value}</span></div>
                <div>Threshold: <span className="text-cohere-muted">{selectedAlarm.threshold_value}</span></div>
              </div>

              <div className="p-2.5 rounded-xs bg-cohere-surface border border-cohere-border text-white">
                <div className="font-semibold text-[10.5px] uppercase text-cohere-muted">Recommended Action:</div>
                <div className="mt-0.5">{selectedAlarm.recommended_action}</div>
              </div>
            </div>

            <div className="flex items-center justify-end space-x-2 pt-2 border-t border-cohere-border text-xs font-mono">
              <button
                onClick={() => {
                  handleAcknowledgeAlarm(selectedAlarm.alarm_id);
                  setSelectedAlarm(null);
                }}
                className="px-3 py-1.5 rounded-pill bg-cohere-surface border border-cohere-border text-cohere-textSecondary hover:text-white"
              >
                Acknowledge (NEW &rarr; ACK)
              </button>
              <button
                onClick={() => {
                  handleResolveAlarm(selectedAlarm.alarm_id);
                  setSelectedAlarm(null);
                }}
                className="px-3.5 py-1.5 rounded-pill bg-scm-healthy text-white font-semibold hover:bg-teal-600"
              >
                Resolve Exception
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
