import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { 
  AlertTriangle, 
  CheckCircle2, 
  ArrowRight, 
  FileText, 
  Download, 
  RefreshCw, 
  Layers, 
  Sliders,
  DollarSign,
  TrendingDown,
  TrendingUp,
  ShieldAlert,
  ChevronDown,
  ChevronRight,
  Sparkles,
  PieChart as PieIcon,
  BarChart2,
  Check
} from "lucide-react";
import { api } from "../api/client";
import { 
  HealthRibbon, 
  NationalKPIs, 
  HeatmapResponse, 
  RiskMatrixResponse, 
  RebalancingProposal, 
  LossAttributionData, 
  AlarmItem,
  ForecastAccuracyComparison,
  PulpBuildTimelineData
} from "../types";
import { EChart } from "../components/EChart";

export const ControlTower: React.FC = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  const [ribbon, setRibbon] = useState<HealthRibbon | null>(null);
  const [kpis, setKpis] = useState<NationalKPIs | null>(null);
  const [heatmap, setHeatmap] = useState<HeatmapResponse | null>(null);
  const [selectedMetric, setSelectedMetric] = useState<string>("allocation_gap");
  const [riskMatrix, setRiskMatrix] = useState<RiskMatrixResponse | null>(null);
  const [proposals, setProposals] = useState<RebalancingProposal[]>([]);
  const [lossAttr, setLossAttr] = useState<LossAttributionData | null>(null);
  const [alarms, setAlarms] = useState<AlarmItem[]>([]);
  const [alarmFilterSev, setAlarmFilterSev] = useState<string>("ALL");
  const [reportPreview, setReportPreview] = useState<any>(null);
  const [generatingReport, setGeneratingReport] = useState<boolean>(false);
  const [selectedAlarm, setSelectedAlarm] = useState<AlarmItem | null>(null);

  // Forecast Accuracy National vs Local (Visualization 2)
  const [forecastAccuracy, setForecastAccuracy] = useState<ForecastAccuracyComparison | null>(null);

  // Pre-Summer Passionfruit Pulp Build Timeline (Visualization 4)
  const [pulpTimeline, setPulpTimeline] = useState<PulpBuildTimelineData | null>(null);
  const [showPulpTimeline, setShowPulpTimeline] = useState<boolean>(true);
  const [pulpStartingCover, setPulpStartingCover] = useState<number>(14);
  const [pulpTargetCover, setPulpTargetCover] = useState<number>(24);
  const [pulpWeeklyBuildKg, setPulpWeeklyBuildKg] = useState<number>(18000);
  const [pulpHoldingCostRate, setPulpHoldingCostRate] = useState<number>(12.50);

  // Sliders state
  const [sliderLate, setSliderLate] = useState<number>(35);
  const [sliderStale, setSliderStale] = useState<number>(40);
  const [sliderPulp, setSliderPulp] = useState<number>(25);

  // Collapsible section toggles
  const [showCausalLoop, setShowCausalLoop] = useState<boolean>(false);
  const [showFeasibility, setShowFeasibility] = useState<boolean>(false);
  const [showWeeklyReport, setShowWeeklyReport] = useState<boolean>(true);

  const loadData = async () => {
    try {
      setLoading(true);
      setError(null);
      const [rRibbon, rKpis, rHeatmap, rMatrix, rRebal, rLoss, rAlarms, rReport, rForecast, rPulp] = await Promise.all([
        api.getHealthRibbon(),
        api.getNationalKPIs(),
        api.getHeatmap(selectedMetric),
        api.getRiskMatrix(),
        api.getRebalancingNetwork(),
        api.getLossAttribution(),
        api.getAlarms(),
        api.getReportPreview("2026-W18"),
        api.getForecastAccuracyComparison("VINTAGE-2026-W18"),
        api.getPulpBuildTimeline(pulpStartingCover, pulpTargetCover, pulpWeeklyBuildKg, pulpHoldingCostRate),
      ]);

      setRibbon(rRibbon);
      setKpis(rKpis);
      setHeatmap(rHeatmap);
      setRiskMatrix(rMatrix);
      setProposals(rRebal.proposals);
      setLossAttr(rLoss);
      setAlarms(rAlarms.alarms);
      setReportPreview(rReport);
      setForecastAccuracy(rForecast);
      setPulpTimeline(rPulp);

      if (rLoss.root_cause_breakdown) {
        setSliderLate(rLoss.root_cause_breakdown.late_demand_detection?.share_pct || 35);
        setSliderStale(rLoss.root_cause_breakdown.stale_allocation_censored_loop?.share_pct || 40);
        setSliderPulp(rLoss.root_cause_breakdown.single_source_pulp_rationing?.share_pct || 25);
      }
    } catch (err: any) {
      setError(err.message || "Failed to load Control Tower data");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, [selectedMetric]);

  const handleSliderChange = async (key: string, val: number) => {
    if (!lossAttr) return;
    try {
      const currentShares = {
        late_demand_detection: sliderLate,
        stale_allocation_censored_loop: sliderStale,
        single_source_pulp_rationing: sliderPulp,
      };
      const res = await api.redistributeLosses(key, val, currentShares);
      setLossAttr(res);
      setSliderLate(res.root_cause_breakdown.late_demand_detection.share_pct);
      setSliderStale(res.root_cause_breakdown.stale_allocation_censored_loop.share_pct);
      setSliderPulp(res.root_cause_breakdown.single_source_pulp_rationing.share_pct);
    } catch (e: any) {
      console.error(e);
    }
  };

  const handleAcknowledgeAlarm = async (alarmId: string) => {
    try {
      await api.acknowledgeAlarm(alarmId, "Executive-Planner");
      const rAlarms = await api.getAlarms();
      setAlarms(rAlarms.alarms);
    } catch (e) {
      console.error(e);
    }
  };

  const handleResolveAlarm = async (alarmId: string) => {
    try {
      await api.resolveAlarm(alarmId, "Resolved via Executive Control Tower");
      const rAlarms = await api.getAlarms();
      setAlarms(rAlarms.alarms);
    } catch (e) {
      console.error(e);
    }
  };

  const handleDownloadReport = async () => {
    try {
      setGeneratingReport(true);
      const res = await api.generateReport("2026-W18");
      window.open(res.download_url, "_blank");
    } catch (e: any) {
      alert("Report generation failed: " + e.message);
    } finally {
      setGeneratingReport(false);
    }
  };

  const filteredAlarms = alarms.filter(a => {
    if (alarmFilterSev === "ALL") return true;
    return a.severity === alarmFilterSev;
  });

  // =========================================================================
  // ECHARTS CONFIGURATIONS
  // =========================================================================

  // CHART 1: FLAVOUR X DEPOT HEATMAP
  const heatmapOption = React.useMemo(() => {
    if (!heatmap) return {};
    const data: [number, number, number][] = [];
    let minVal = 0;
    let maxVal = 100;

    heatmap.rows.forEach((row, rIdx) => {
      heatmap.columns.forEach((col, cIdx) => {
        const val = heatmap.matrix[rIdx]?.[cIdx] ?? 0;
        data.push([cIdx, rIdx, val]);
        if (val < minVal) minVal = val;
        if (val > maxVal) maxVal = val;
      });
    });

    const isDoC = selectedMetric === "days_of_cover";
    const isWAPE = selectedMetric === "wape_pct";

    return {
      backgroundColor: "transparent",
      tooltip: {
        position: "top",
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          const colName = heatmap.columns[params.data[0]];
          const rowName = heatmap.rows[params.data[1]];
          const val = params.data[2];
          const formattedVal = isDoC ? `${val}d Cover` : isWAPE ? `${val}% WAPE` : `${val.toLocaleString()} bottles gap`;
          return `<div style="font-weight:600; color:#ffffff;">${colName} @ ${rowName}</div>
                  <div style="margin-top:4px; font-family:monospace;">${formattedVal}</div>
                  <div style="color:#8e91a2; font-size:10px; margin-top:2px;">Click to drill down in Depot Explorer</div>`;
        },
      },
      grid: { top: 30, right: 20, bottom: 40, left: 110 },
      xAxis: {
        type: "category",
        data: heatmap.columns,
        splitArea: { show: true },
        axisLabel: { color: "#f5f6fa", fontWeight: 500, fontSize: 11 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "category",
        data: heatmap.rows,
        splitArea: { show: true },
        axisLabel: { color: "#b3b6c7", fontSize: 11 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      visualMap: {
        min: minVal,
        max: maxVal,
        calculable: true,
        orient: "horizontal",
        left: "center",
        bottom: 0,
        itemWidth: 10,
        itemHeight: 120,
        textStyle: { color: "#8e91a2", fontSize: 10, fontFamily: "monospace" },
        inRange: isDoC 
          ? { color: ["#dc2626", "#d97706", "#181922", "#0d9488"] }
          : { color: ["#0d9488", "#181922", "#d97706", "#dc2626"] },
      },
      series: [
        {
          name: "Heatmap Metric",
          type: "heatmap",
          data: data,
          label: {
            show: true,
            color: "#f5f6fa",
            fontSize: 10,
            fontFamily: "JetBrains Mono, monospace",
            formatter: (p: any) => isDoC ? `${p.data[2]}d` : isWAPE ? `${p.data[2]}%` : `${Math.round(p.data[2] / 1000)}k`,
          },
          emphasis: {
            itemStyle: {
              shadowBlur: 8,
              shadowColor: "rgba(0, 0, 0, 0.6)",
              borderColor: "#1863dc",
              borderWidth: 1,
            },
          },
        },
      ],
    };
  }, [heatmap, selectedMetric]);

  // CHART 2: DEMAND VS INVENTORY RISK MATRIX
  const riskMatrixOption = React.useMemo(() => {
    if (!riskMatrix) return {};

    const points = riskMatrix.points.map(pt => [
      pt.forecast_demand,
      pt.days_of_cover,
      pt.allocation_gap,
      pt.sku_id,
      pt.depot_id,
      pt.risk_level,
      pt.projected_stockout_date,
    ]);

    return {
      backgroundColor: "transparent",
      tooltip: {
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          const d = params.data;
          const isCrit = d[5] === "CRITICAL";
          return `<div style="font-weight:600; color:${isCrit ? '#dc2626' : '#ffffff'}; font-family:monospace;">${d[3]} @ ${d[4]}</div>
                  <div style="margin-top:4px;">DoC: <b>${d[1]} days</b> | Demand: <b>${Math.round(d[0]).toLocaleString()} btls/d</b></div>
                  <div style="color:#b3b6c7;">Allocation Gap: ${d[2] > 0 ? `+${d[2].toLocaleString()}` : d[2].toLocaleString()} btls</div>
                  <div style="color:${isCrit ? '#dc2626' : '#8e91a2'}; font-size:10px;">Stock-out ETA: ${d[6]}</div>
                  <div style="color:#1863dc; font-size:10px; margin-top:2px;">Click to drill down</div>`;
        },
      },
      grid: { top: 30, right: 30, bottom: 45, left: 55 },
      xAxis: {
        type: "value",
        name: "Corrected Daily Demand (btls/d)",
        nameLocation: "middle",
        nameGap: 28,
        nameTextStyle: { color: "#8e91a2", fontSize: 10 },
        splitLine: { lineStyle: { color: "#282937", type: "dashed" } },
        axisLabel: { color: "#b3b6c7", fontSize: 10 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "value",
        name: "Days of Cover (DoC)",
        nameTextStyle: { color: "#8e91a2", fontSize: 10 },
        splitLine: { lineStyle: { color: "#282937", type: "dashed" } },
        axisLabel: { color: "#b3b6c7", fontSize: 10 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      series: [
        {
          type: "scatter",
          data: points,
          symbolSize: (val: any) => {
            const gap = Math.abs(val[2] || 10000);
            return Math.max(10, Math.min(26, gap / 60000));
          },
          itemStyle: {
            color: (params: any) => {
              const r = params.data[5];
              if (r === "CRITICAL") return "#dc2626";
              if (r === "WARNING") return "#d97706";
              return "#0d9488";
            },
            shadowBlur: 4,
            shadowColor: "rgba(0,0,0,0.5)",
          },
          markLine: {
            silent: true,
            lineStyle: { type: "dashed", width: 1 },
            data: [
              { yAxis: 21, lineStyle: { color: "#0d9488" }, label: { formatter: "21d Target", color: "#0d9488", position: "end" } },
              { yAxis: 7, lineStyle: { color: "#dc2626" }, label: { formatter: "7d Cliff", color: "#dc2626", position: "end" } },
            ],
          },
          markArea: {
            silent: true,
            itemStyle: { color: "rgba(220, 38, 38, 0.05)" },
            data: [
              [
                { yAxis: 0, xAxis: 3500 },
                { yAxis: 7, xAxis: 15000 },
              ],
            ],
          },
        },
      ],
    };
  }, [riskMatrix]);

  // CHART 3: DEPOT REBALANCING NETWORK
  const rebalancingNetworkOption = React.useMemo(() => {
    const depotNodes = [
      { name: "Depot-North-01", label: "Delhi NCR", x: 200, y: 50, symbolSize: 32, category: 0 },
      { name: "Depot-North-02", label: "Lucknow", x: 300, y: 90, symbolSize: 26, category: 1 },
      { name: "Depot-West-01", label: "Mumbai", x: 100, y: 220, symbolSize: 36, category: 0 },
      { name: "Depot-West-02", label: "Ahmedabad", x: 80, y: 130, symbolSize: 26, category: 1 },
      { name: "Depot-Central-01", label: "Indore", x: 210, y: 170, symbolSize: 28, category: 2 },
      { name: "Depot-South-01", label: "Bengaluru", x: 190, y: 310, symbolSize: 30, category: 2 },
      { name: "Depot-South-02", label: "Chennai", x: 280, y: 300, symbolSize: 32, category: 1 },
      { name: "Depot-East-01", label: "Kolkata", x: 390, y: 180, symbolSize: 28, category: 1 },
      { name: "Depot-East-02", label: "Guwahati", x: 470, y: 120, symbolSize: 24, category: 0 },
    ];

    const links = proposals.map(p => ({
      source: p.origin_depot_id,
      target: p.destination_depot_id,
      value: p.quantity_bottles,
      sku: p.sku_id,
      cost: p.cost_inr,
      eta: p.eta_days,
      donorPost: p.donor_post_cover_days,
      status: p.status,
      selectionRationale: p.selection_rationale,
      lineStyle: {
        width: Math.max(2, Math.min(6, p.quantity_bottles / 15000)),
        curveness: 0.25,
        color: p.status === "APPROVED" ? "#0d9488" : "#1863dc",
        type: p.status === "PENDING" ? "dashed" : "solid",
      },
    }));

    return {
      backgroundColor: "transparent",
      tooltip: {
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          if (params.dataType === "edge") {
            const d = params.data;
            const statusBadge = d.status === "APPROVED" ? "[APPROVED FOR DISPATCH]" : "[PROPOSED - PENDING APPROVAL]";
            return `<div style="font-weight:600; color:#ffffff; font-family:monospace;">LANE: ${d.source} ➔ ${d.target}</div>
                    <div style="margin-top:3px;">SKU: <b>${d.sku}</b> | Transfer: <b>${d.value.toLocaleString()} btls</b></div>
                    <div style="color:#b3b6c7;">Freight: ₹${Math.round(d.cost).toLocaleString()} (@ ₹1.50/btl) | ETA: <b>${d.eta}d</b></div>
                    <div style="color:#0d9488;">Donor Post-Cover: <b>${d.donorPost}d</b> (&ge;21d target)</div>
                    ${d.selectionRationale ? `<div style="color:#60a5fa; font-size:10px; margin-top:3px;"><b>Ranked Choice:</b> ${d.selectionRationale}</div>` : ""}
                    <div style="color:${d.status === 'APPROVED' ? '#0d9488' : '#1863dc'}; font-size:10px; margin-top:2px; font-weight:600;">Status: ${statusBadge}</div>`;
          }
          return `<div style="font-weight:600; color:#ffffff;">${params.data.label} (${params.data.name})</div>`;
        },
      },
      legend: {
        data: ["Shortage Depot", "Surplus Donor", "Balanced Depot"],
        textStyle: { color: "#b3b6c7", fontSize: 10 },
        bottom: 0,
      },
      series: [
        {
          type: "graph",
          layout: "none",
          roam: false,
          edgeSymbol: ["circle", "arrow"],
          edgeSymbolSize: [4, 10],
          categories: [
            { name: "Shortage Depot", itemStyle: { color: "#dc2626" } },
            { name: "Surplus Donor", itemStyle: { color: "#0d9488" } },
            { name: "Balanced Depot", itemStyle: { color: "#717487" } },
          ],
          data: depotNodes.map(n => ({
            ...n,
            label: {
              show: true,
              position: "bottom",
              color: "#f5f6fa",
              fontSize: 10,
              formatter: n.label,
            },
          })),
          links: links,
          lineStyle: { opacity: 0.85 },
          emphasis: {
            focus: "adjacency",
            lineStyle: { width: 4 },
          },
        },
      ],
    };
  }, [proposals]);

  // CHART 4: HISTORICAL LOSS ATTRIBUTION
  const lossAttributionOption = React.useMemo(() => {
    if (!lossAttr) return {};

    const categories = [
      "Emergency Air Freight",
      "Write-Offs & Discounts",
      "Foregone Contribution",
      "Stock-Out Lost Revenue",
    ];

    const values = [
      lossAttr.emergency_air_freight_inr_cr,
      lossAttr.writeoffs_and_discounts_inr_cr,
      lossAttr.foregone_contribution_inr_cr,
      lossAttr.stockout_lost_revenue_inr_cr,
    ];

    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          const p = params[0];
          return `<div style="font-weight:600; color:#ffffff;">${p.name}</div>
                  <div style="margin-top:3px; font-family:monospace; font-size:12px;">₹${p.value} Crores</div>
                  <div style="color:#8e91a2; font-size:10px;">${p.dataIndex === 3 ? "Top-Line Metric (Do NOT sum with contribution)" : "Bottom-Line Impact Category"}</div>`;
        },
      },
      grid: { top: 15, right: 35, bottom: 20, left: 145 },
      xAxis: {
        type: "value",
        axisLabel: { formatter: "₹{value} Cr", color: "#b3b6c7", fontSize: 10 },
        splitLine: { lineStyle: { color: "#282937", type: "dashed" } },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "category",
        data: categories,
        axisLabel: { color: "#f5f6fa", fontSize: 11 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      series: [
        {
          name: "Financial Impact",
          type: "bar",
          data: values.map((val, idx) => ({
            value: val,
            itemStyle: {
              color: idx === 3 ? "#717487" : idx === 2 ? "#1863dc" : idx === 1 ? "#d97706" : "#dc2626",
              borderRadius: [0, 2, 2, 0],
            },
          })),
          label: {
            show: true,
            position: "right",
            formatter: "₹{c} Cr",
            color: "#f5f6fa",
            fontFamily: "JetBrains Mono, monospace",
            fontWeight: 600,
            fontSize: 11,
          },
        },
      ],
    };
  }, [lossAttr]);

  // ADDITIONAL CHART: SKU DEMAND MIX (DONUT)
  const skuDemandMixOption = React.useMemo(() => {
    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "item",
        backgroundColor: "#181922",
        borderColor: "#282937",
        textStyle: { color: "#f5f6fa", fontSize: 11 },
        formatter: "{b}: <b>{c}%</b> of Summer Demand",
      },
      legend: {
        orient: "vertical",
        right: 10,
        top: "middle",
        textStyle: { color: "#b3b6c7", fontSize: 10, fontFamily: "Inter, sans-serif" },
        itemWidth: 10,
        itemHeight: 10,
      },
      series: [
        {
          name: "Summer Demand Mix",
          type: "pie",
          radius: ["45%", "75%"],
          center: ["38%", "50%"],
          avoidLabelOverlap: false,
          label: { show: false },
          emphasis: {
            label: {
              show: true,
              fontSize: 12,
              fontWeight: "bold",
              color: "#ffffff",
              formatter: "{b}\n{c}%",
            },
          },
          data: [
            { value: 38, name: "PR-MPB (Mango)", itemStyle: { color: "#1863dc" } },
            { value: 20, name: "PR-GC (Guava)", itemStyle: { color: "#0d9488" } },
            { value: 16, name: "PR-PP (Pulp Passion)", itemStyle: { color: "#d97706" } },
            { value: 14, name: "PR-DB (Dragon Berry)", itemStyle: { color: "#7c3aed" } },
            { value: 12, name: "PR-DP (Dragon Passion)", itemStyle: { color: "#dc2626" } },
          ],
        },
      ],
    };
  }, []);

  // ADDITIONAL CHART: INVENTORY RISK DISTRIBUTION (STACKED BARS)
  const inventoryRiskDistOption = React.useMemo(() => {
    if (!riskMatrix) return {};
    let critCount = 0;
    let warnCount = 0;
    let healthyCount = 0;

    riskMatrix.points.forEach(pt => {
      if (pt.risk_level === "CRITICAL") critCount++;
      else if (pt.risk_level === "WARNING") warnCount++;
      else healthyCount++;
    });

    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        backgroundColor: "#181922",
        borderColor: "#282937",
        textStyle: { color: "#f5f6fa", fontSize: 11 },
      },
      grid: { top: 20, right: 20, bottom: 25, left: 40 },
      xAxis: {
        type: "category",
        data: ["Risk Bands (45 Total)"],
        axisLine: { lineStyle: { color: "#282937" } },
        axisLabel: { show: false },
      },
      yAxis: {
        type: "value",
        max: 45,
        splitLine: { lineStyle: { color: "#282937" } },
        axisLabel: { color: "#8e91a2", fontSize: 10 },
      },
      series: [
        {
          name: "Critical (<7d)",
          type: "bar",
          stack: "total",
          data: [critCount],
          itemStyle: { color: "#dc2626" },
          label: { show: true, formatter: "{c} Crit", color: "#f5f6fa", fontSize: 10 },
        },
        {
          name: "Warning (7-14d)",
          type: "bar",
          stack: "total",
          data: [warnCount],
          itemStyle: { color: "#d97706" },
          label: { show: true, formatter: "{c} Warn", color: "#ffffff", fontSize: 10, fontWeight: 600 },
        },
        {
          name: "Healthy (>=21d)",
          type: "bar",
          stack: "total",
          data: [healthyCount],
          itemStyle: { color: "#0d9488" },
          label: { show: true, formatter: "{c} Safe", color: "#ffffff", fontSize: 10, fontWeight: 600 },
        },
      ],
    };
  }, [riskMatrix]);

  // CHART 5: FORECAST ACCURACY BENCHMARK
  const forecastAccuracyOption = React.useMemo(() => {
    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        backgroundColor: "#181922",
        borderColor: "#282937",
        textStyle: { color: "#f5f6fa", fontSize: 11 },
        formatter: (params: any) => {
          let s = `<div style="font-weight:600; color:#ffffff;">${params[0].name}</div>`;
          params.forEach((p: any) => {
            s += `<div>${p.marker} ${p.seriesName}: <b>${p.value}% WAPE</b></div>`;
          });
          return s;
        },
      },
      legend: {
        data: ["RIOT RADAR S&OP", "Naive Benchmark"],
        textStyle: { color: "#b3b6c7", fontSize: 10 },
        top: 0,
      },
      grid: { top: 30, right: 20, bottom: 30, left: 50 },
      xAxis: {
        type: "category",
        data: ["Observed Sales", "Corrected Latent", "Synthetic Ground Truth"],
        axisLabel: { color: "#b3b6c7", fontSize: 10 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "value",
        name: "WAPE % (Lower is better)",
        nameTextStyle: { color: "#8e91a2", fontSize: 9 },
        axisLabel: { formatter: "{value}%", color: "#8e91a2", fontSize: 10 },
        splitLine: { lineStyle: { color: "#282937" } },
      },
      series: [
        {
          name: "RIOT RADAR S&OP",
          type: "bar",
          data: [10.7, 12.1, 9.8],
          itemStyle: { color: "#1863dc", borderRadius: [2, 2, 0, 0] },
          label: { show: true, position: "top", formatter: "{c}%", color: "#f5f6fa", fontSize: 10, fontFamily: "monospace" },
        },
        {
          name: "Naive Benchmark",
          type: "bar",
          data: [22.4, 28.6, 24.1],
          itemStyle: { color: "#36384a", borderRadius: [2, 2, 0, 0] },
          label: { show: true, position: "top", formatter: "{c}%", color: "#b3b6c7", fontSize: 10, fontFamily: "monospace" },
        },
      ],
    };
  }, []);

  // CHART 6: FORECAST ERROR AND BIAS OVER TIME
  const forecastErrorTrendOption = React.useMemo(() => {
    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        backgroundColor: "#181922",
        borderColor: "#282937",
        textStyle: { color: "#f5f6fa", fontSize: 11 },
      },
      legend: {
        data: ["Forecast WAPE %", "Forecast Bias %"],
        textStyle: { color: "#b3b6c7", fontSize: 10 },
        top: 0,
      },
      grid: { top: 30, right: 45, bottom: 25, left: 45 },
      xAxis: {
        type: "category",
        data: ["W14", "W15", "W16", "W17", "W18 (Current)"],
        axisLabel: { color: "#b3b6c7", fontSize: 10 },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: [
        {
          type: "value",
          name: "WAPE %",
          nameTextStyle: { color: "#8e91a2", fontSize: 9 },
          axisLabel: { formatter: "{value}%", color: "#8e91a2", fontSize: 10 },
          splitLine: { lineStyle: { color: "#282937" } },
        },
        {
          type: "value",
          name: "Bias %",
          nameTextStyle: { color: "#8e91a2", fontSize: 9 },
          axisLabel: { formatter: "{value}%", color: "#8e91a2", fontSize: 10 },
          splitLine: { show: false },
        },
      ],
      series: [
        {
          name: "Forecast WAPE %",
          type: "line",
          smooth: true,
          data: [19.2, 16.5, 14.1, 11.8, 10.7],
          lineStyle: { color: "#1863dc", width: 2 },
          itemStyle: { color: "#1863dc" },
        },
        {
          name: "Forecast Bias %",
          type: "line",
          yAxisIndex: 1,
          smooth: true,
          data: [4.8, 3.2, 1.9, 0.4, -0.6],
          lineStyle: { color: "#0d9488", width: 2, type: "dashed" },
          itemStyle: { color: "#0d9488" },
        },
      ],
    };
  }, []);

  const handlePulpParamChange = async (startCover: number, tgtCover: number, weeklyBuild: number, rate: number) => {
    setPulpStartingCover(startCover);
    setPulpTargetCover(tgtCover);
    setPulpWeeklyBuildKg(weeklyBuild);
    setPulpHoldingCostRate(rate);
    try {
      const res = await api.getPulpBuildTimeline(startCover, tgtCover, weeklyBuild, rate);
      setPulpTimeline(res);
    } catch (e) {
      console.error("Failed to update pulp timeline:", e);
    }
  };

  // CHART: NATIONAL FORECAST ACCURACY VS SKU-DEPOT FORECAST ERROR (VISUALIZATION 2)
  const nationalVsLocalForecastOption = React.useMemo(() => {
    if (!forecastAccuracy) return {};

    const natWape = forecastAccuracy.national_panel.wape_pct;
    const localWape = forecastAccuracy.sku_depot_panel.wape_pct;
    const natBiasAbs = Math.abs(forecastAccuracy.national_panel.bias_pct);
    const localMeanAbsBias = forecastAccuracy.sku_depot_panel.mean_absolute_bias_pct;

    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          let html = `<div style="font-weight:600; color:#ffffff; font-family:monospace; margin-bottom:3px;">
            ${params[0].name}
          </div>`;
          params.forEach((p: any) => {
            html += `<div style="color:#b3b6c7;">${p.marker} ${p.seriesName}: <b style="color:#ffffff;">${p.value}%</b></div>`;
          });
          if (params[0].name.includes("Bias")) {
            html += `<div style="color:#ef4444; font-size:10px; margin-top:3px;">Signed National Bias: <b>${forecastAccuracy.national_panel.bias_pct}% (${forecastAccuracy.national_panel.bias_direction})</b></div>`;
            html += `<div style="color:#d97706; font-size:10px;">Cancelling Error Gap: <b>+${forecastAccuracy.sku_depot_panel.cancelling_error_gap_pct}%</b> masked at national level</div>`;
          }
          return html;
        },
      },
      legend: {
        data: ["National Aggregate Level", "SKU–Depot Local Disaggregated"],
        textStyle: { color: "#b3b6c7", fontSize: 10, fontFamily: "Inter, sans-serif" },
        top: 0,
      },
      grid: { top: 32, right: 20, bottom: 25, left: 45 },
      xAxis: {
        type: "category",
        data: ["WAPE Error %", "Mean Absolute Bias %"],
        axisLabel: { color: "#b3b6c7", fontSize: 11, fontFamily: "Inter, sans-serif" },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "value",
        axisLabel: { formatter: "{value}%", color: "#8e91a2", fontSize: 10, fontFamily: "JetBrains Mono, monospace" },
        splitLine: { lineStyle: { color: "#1e293b", type: "dashed" } },
      },
      series: [
        {
          name: "National Aggregate Level",
          type: "bar",
          data: [natWape, natBiasAbs],
          itemStyle: { color: "#64748b", borderRadius: [2, 2, 0, 0] },
          label: { show: true, position: "top", formatter: "{c}%", color: "#94a3b8", fontSize: 10, fontFamily: "JetBrains Mono, monospace" },
        },
        {
          name: "SKU–Depot Local Disaggregated",
          type: "bar",
          data: [localWape, localMeanAbsBias],
          itemStyle: { color: "#1863dc", borderRadius: [2, 2, 0, 0] },
          label: { show: true, position: "top", formatter: "{c}%", color: "#f5f6fa", fontWeight: 600, fontSize: 10, fontFamily: "JetBrains Mono, monospace" },
        },
      ],
    };
  }, [forecastAccuracy]);

  // CHART: PRE-SUMMER PASSIONFRUIT PULP BUILD TIMELINE (VISUALIZATION 4)
  const pulpBuildTimelineOption = React.useMemo(() => {
    if (!pulpTimeline || !pulpTimeline.weekly_timeline) return {};

    const weeks = pulpTimeline.weekly_timeline.map(w => w.week_label);
    const coverDays = pulpTimeline.weekly_timeline.map(w => w.projected_cover_days);
    const targetRef = pulpTimeline.planning_parameters.target_buffer_cover_days;

    return {
      backgroundColor: "transparent",
      tooltip: {
        trigger: "axis",
        backgroundColor: "#181922",
        borderColor: "#282937",
        borderWidth: 1,
        textStyle: { color: "#f5f6fa", fontSize: 11, fontFamily: "Inter, sans-serif" },
        formatter: (params: any) => {
          if (!params || params.length === 0) return "";
          const idx = params[0].dataIndex;
          const wItem = pulpTimeline.weekly_timeline[idx];
          return `<div style="font-weight:600; color:#ffffff; font-family:monospace; margin-bottom:3px;">
            ${wItem.week_label} (Pre-Summer Planning)
          </div>
          <div style="color:#38bdf8;">Projected Pulp Cover: <b>${wItem.projected_cover_days} days</b></div>
          <div style="color:#b3b6c7;">Pulp Inventory: <b>${wItem.pulp_stock_kg.toLocaleString()} kg</b></div>
          <div style="color:#94a3b8;">Planned Procurement: <b>${wItem.planned_weekly_procurement_kg.toLocaleString()} kg</b></div>
          <div style="color:${wItem.is_target_achieved ? '#0d9488' : '#d97706'}; font-size:10px; margin-top:2px;">
            Target Buffer: ${targetRef}d (${wItem.is_target_achieved ? 'TARGET ACHIEVED' : 'BUILDING BUFFER'})
          </div>`;
        },
      },
      legend: {
        data: ["Projected Pulp Cover (Days)"],
        textStyle: { color: "#b3b6c7", fontSize: 10, fontFamily: "Inter, sans-serif" },
        top: 0,
      },
      grid: { top: 35, right: 35, bottom: 25, left: 45 },
      xAxis: {
        type: "category",
        data: weeks,
        axisLabel: { color: "#b3b6c7", fontSize: 10, fontFamily: "Inter, sans-serif" },
        axisLine: { lineStyle: { color: "#282937" } },
      },
      yAxis: {
        type: "value",
        name: "Days of Cover",
        nameTextStyle: { color: "#8e91a2", fontSize: 9 },
        axisLabel: { formatter: "{value}d", color: "#8e91a2", fontSize: 10, fontFamily: "JetBrains Mono, monospace" },
        splitLine: { lineStyle: { color: "#1e293b", type: "dashed" } },
        min: 10,
        max: Math.max(30, targetRef + 6),
      },
      series: [
        {
          name: "Projected Pulp Cover (Days)",
          type: "line",
          data: coverDays,
          smooth: true,
          lineStyle: { color: "#1863dc", width: 2.5 },
          itemStyle: { color: "#1863dc" },
          areaStyle: {
            color: "rgba(24, 99, 220, 0.12)",
          },
          markLine: {
            silent: true,
            data: [
              {
                yAxis: targetRef,
                lineStyle: { color: "#0d9488", type: "dashed", width: 2 },
                label: { formatter: `Target Buffer: ${targetRef}d (21d Closure + 3d Transit)`, color: "#0d9488", position: "middle" },
              },
              {
                yAxis: 21.0,
                lineStyle: { color: "#d97706", type: "dotted", width: 1.5 },
                label: { formatter: "Highway Closure: 21d Outage", color: "#d97706", position: "start" },
              },
            ],
          },
        },
      ],
    };
  }, [pulpTimeline]);

  return (
    <div className="space-y-5 pb-8">
      {/* 1. TOP HEADER & HEALTH RIBBON */}
      <section className="space-y-3">
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-2 border-b border-cohere-border pb-3">
          <div>
            <h1 className="text-xl font-semibold tracking-tight text-white flex items-center space-x-2">
              <span>National Operations Control Tower</span>
              <span className="badge-neutral">EXECUTIVE S&amp;OP</span>
            </h1>
            <p className="text-xs text-cohere-textMuted mt-0.5">
              Multi-echelon demand sensing, live inventory cover telemetry, and inter-depot rebalancing governance.
            </p>
          </div>
          <div className="flex items-center space-x-2">
            <button
              onClick={loadData}
              className="button-pill-outline text-xs"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${loading ? "animate-spin text-cohere-actionBlue" : ""}`} />
              <span>Telemetry Sync</span>
            </button>
          </div>
        </div>

        {/* 5-MODULE HEALTH RIBBON */}
        {ribbon && (
          <div className="grid grid-cols-2 md:grid-cols-5 gap-2.5">
            {Object.entries(ribbon).map(([modName, modData]) => {
              const isCrit = modData.rag_status === "CRITICAL";
              const isWarn = modData.rag_status === "WARN";
              const borderClass = isCrit ? "border-l-2 border-l-scm-critical border-cohere-border" : isWarn ? "border-l-2 border-l-scm-warning border-cohere-border" : "border-l-2 border-l-scm-healthy border-cohere-border";
              const badgeClass = isCrit ? "badge-critical" : isWarn ? "badge-warn" : "badge-ok";

              return (
                <div 
                  key={modName}
                  className={`p-3 rounded-xs bg-cohere-card border ${borderClass} flex flex-col justify-between`}
                >
                  <div className="flex items-center justify-between">
                    <span className="font-mono text-[10px] font-medium uppercase tracking-wider text-cohere-muted">
                      {modName}
                    </span>
                    <span className={badgeClass}>[{modData.rag_status}]</span>
                  </div>
                  <div className="my-1.5 text-xs font-semibold text-white line-clamp-2 leading-tight">
                    {modData.reason}
                  </div>
                  <div className="text-[10px] font-mono text-cohere-muted flex items-center justify-between border-t border-cohere-border/60 pt-1 mt-1">
                    <span>ACTION:</span>
                    <span className="text-cohere-actionBlue font-medium truncate ml-1">{modData.action_required}</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>

      {/* VISUALIZATION 4: PRE-SUMMER PASSIONFRUIT PULP BUILD TIMELINE (EXPANDABLE SECTION BENEATH HEALTH MODULES) */}
      <section className="bg-cohere-card border border-cohere-border rounded-xs overflow-hidden">
        <button
          onClick={() => setShowPulpTimeline(!showPulpTimeline)}
          className="w-full p-3 flex items-center justify-between text-left hover:bg-cohere-surface/40 transition-colors"
        >
          <div className="flex items-center space-x-2">
            <span className="font-mono font-medium text-xs text-white uppercase tracking-wider">
              Strategic Bottleneck — Pre-Summer Passionfruit Pulp Build Timeline
            </span>
            <span className="badge-warn">[SUPPLY BOTTLENECK PLANNING]</span>
            <span className="badge-neutral text-[10px]">CASE STUDY: NH-44 DISRUPTION BUFFER</span>
          </div>
          <div className="flex items-center space-x-2 text-xs text-cohere-muted font-mono">
            <span>{pulpTimeline?.weekly_timeline ? `${pulpTimeline.weekly_timeline.length} WEEKS TO MARCH` : "8 WEEKS TO MARCH"}</span>
            {showPulpTimeline ? <ChevronDown className="w-4 h-4 text-cohere-muted" /> : <ChevronRight className="w-4 h-4 text-cohere-muted" />}
          </div>
        </button>

        {showPulpTimeline && (
          <div className="p-4 border-t border-cohere-border bg-cohere-panel/60 space-y-4">
            {/* Context callout distinguishing case facts from scenario assumptions */}
            <div className="p-3 rounded-xs bg-cohere-card border border-cohere-border text-xs text-cohere-textMuted space-y-1">
              <div className="flex items-center space-x-2 font-mono text-[11px] font-semibold text-white">
                <span className="text-cohere-actionBlue">[CASE FACTS VS SCENARIO ASSUMPTIONS]</span>
              </div>
              <p className="text-[11px] leading-relaxed">
                <strong className="text-cohere-text">Case Facts:</strong> Frozen passionfruit pulp has a maximum shelf-life of 6 months (180 days). Normal road transit from single-source supplier in Krishnagiri to North bottling plants is 3 days. Annual monsoon/pre-summer highway disruptions on NH-44 historically endure up to 3 weeks (21 days). Current starting cover is 14 days, creating a net 7-day inventory deficit without buffer build-up. An emergency air-freight charter cost <strong className="text-scm-critical font-mono">₹3.20 Cr</strong> historically.
              </p>
              <p className="text-[10px] text-cohere-muted">
                *Note: Highway disruption recurrence is an operational planning scenario, not a guaranteed certainty. Holding costs and weekly procurement rates are configurable planner assumptions.
              </p>
            </div>

            {/* Configurable planning parameters */}
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div className="p-2.5 rounded-xs bg-cohere-card border border-cohere-border space-y-1">
                <label className="text-[10px] font-mono uppercase tracking-wider text-cohere-muted block">
                  Starting Pulp Cover (Days)
                </label>
                <div className="flex items-center space-x-2">
                  <input
                    type="range"
                    min="7"
                    max="21"
                    step="1"
                    value={pulpStartingCover}
                    onChange={(e) => handlePulpParamChange(Number(e.target.value), pulpTargetCover, pulpWeeklyBuildKg, pulpHoldingCostRate)}
                    className="w-full accent-cohere-actionBlue"
                  />
                  <span className="font-mono font-semibold text-xs text-white w-10 text-right">{pulpStartingCover}d</span>
                </div>
                <div className="text-[9.5px] font-mono text-cohere-muted">Case baseline: 14d (2 wks)</div>
              </div>

              <div className="p-2.5 rounded-xs bg-cohere-card border border-cohere-border space-y-1">
                <label className="text-[10px] font-mono uppercase tracking-wider text-cohere-muted block">
                  Target Buffer Cover (Days)
                </label>
                <div className="flex items-center space-x-2">
                  <input
                    type="range"
                    min="18"
                    max="35"
                    step="1"
                    value={pulpTargetCover}
                    onChange={(e) => handlePulpParamChange(pulpStartingCover, Number(e.target.value), pulpWeeklyBuildKg, pulpHoldingCostRate)}
                    className="w-full accent-cohere-actionBlue"
                  />
                  <span className="font-mono font-semibold text-xs text-white w-10 text-right">{pulpTargetCover}d</span>
                </div>
                <div className="text-[9.5px] font-mono text-cohere-muted">21d Closure + 3d Transit = 24d</div>
              </div>

              <div className="p-2.5 rounded-xs bg-cohere-card border border-cohere-border space-y-1">
                <label className="text-[10px] font-mono uppercase tracking-wider text-cohere-muted block">
                  Weekly Build-Up (Kg/Wk)
                </label>
                <div className="flex items-center space-x-2">
                  <input
                    type="range"
                    min="5000"
                    max="35000"
                    step="1000"
                    value={pulpWeeklyBuildKg}
                    onChange={(e) => handlePulpParamChange(pulpStartingCover, pulpTargetCover, Number(e.target.value), pulpHoldingCostRate)}
                    className="w-full accent-cohere-actionBlue"
                  />
                  <span className="font-mono font-semibold text-xs text-white w-14 text-right">{(pulpWeeklyBuildKg / 1000).toFixed(0)}k kg</span>
                </div>
                <div className="text-[9.5px] font-mono text-cohere-muted">Procurement allocation rate</div>
              </div>

              <div className="p-2.5 rounded-xs bg-cohere-card border border-cohere-border space-y-1">
                <label className="text-[10px] font-mono uppercase tracking-wider text-cohere-muted block">
                  Cold Storage Holding Cost
                </label>
                <div className="flex items-center space-x-2">
                  <input
                    type="range"
                    min="5"
                    max="30"
                    step="0.5"
                    value={pulpHoldingCostRate}
                    onChange={(e) => handlePulpParamChange(pulpStartingCover, pulpTargetCover, pulpWeeklyBuildKg, Number(e.target.value))}
                    className="w-full accent-cohere-actionBlue"
                  />
                  <span className="font-mono font-semibold text-xs text-white w-14 text-right">₹{pulpHoldingCostRate.toFixed(1)}/kg</span>
                </div>
                <div className="text-[9.5px] font-mono text-cohere-muted">₹/kg/month commercial refrigerated</div>
              </div>
            </div>

            {/* Chart + Financial Comparative Strip */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
              <div className="lg:col-span-2 p-3 rounded-xs bg-cohere-card border border-cohere-border space-y-2">
                <div className="flex items-center justify-between">
                  <div className="text-[11px] font-mono font-medium text-white uppercase">
                    Weekly Cover Trajectory vs 24-Day Target Buffer
                  </div>
                  <div className="flex items-center space-x-3 text-[10px] font-mono">
                    <span className="text-cohere-actionBlue flex items-center space-x-1">
                      <span className="w-2.5 h-0.5 bg-cohere-actionBlue inline-block"></span>
                      <span>Projected Cover</span>
                    </span>
                    <span className="text-scm-healthy flex items-center space-x-1">
                      <span className="w-2.5 h-0.5 border-t border-dashed border-scm-healthy inline-block"></span>
                      <span>24d Target Buffer</span>
                    </span>
                    <span className="text-scm-warning flex items-center space-x-1">
                      <span className="w-2.5 h-0.5 border-t border-dotted border-scm-warning inline-block"></span>
                      <span>21d Closure Duration</span>
                    </span>
                  </div>
                </div>
                <div className="h-56 w-full">
                  <EChart option={pulpBuildTimelineOption} height={220} />
                </div>
              </div>

              {/* Trade-off Financial Comparison Card */}
              <div className="p-3.5 rounded-xs bg-cohere-card border border-cohere-border flex flex-col justify-between space-y-3">
                <div>
                  <div className="text-[11px] font-mono font-medium text-white uppercase tracking-wider mb-2">
                    Strategic Trade-Off Assessment
                  </div>
                  <div className="space-y-2.5">
                    <div className="p-2.5 rounded-xs bg-cohere-panel/50 border border-cohere-border">
                      <div className="text-[10px] font-mono text-cohere-muted">ADDITIONAL BUFFER REQUIRED</div>
                      <div className="text-base font-semibold font-mono text-white mt-0.5">
                        {pulpTimeline?.planning_parameters.required_additional_buffer_kg.toLocaleString() || "123,200"} kg
                        <span className="text-xs text-cohere-muted font-normal ml-1">
                          (+{(pulpTimeline?.planning_parameters.target_buffer_cover_days ?? 24) - (pulpTimeline?.planning_parameters.starting_cover_days ?? 14)} days)
                        </span>
                      </div>
                    </div>

                    <div className="p-2.5 rounded-xs bg-cohere-panel/50 border border-cohere-border">
                      <div className="text-[10px] font-mono text-cohere-muted">BUFFER HOLDING COST (3 MONTHS)</div>
                      <div className="text-base font-semibold font-mono text-cohere-actionBlue mt-0.5">
                        {pulpTimeline?.financial_comparison.estimated_buffer_holding_cost_inr_cr !== null && pulpTimeline?.financial_comparison.estimated_buffer_holding_cost_inr_cr !== undefined
                          ? `₹${pulpTimeline.financial_comparison.estimated_buffer_holding_cost_inr_cr.toFixed(2)} Cr`
                          : "Data unavailable"}
                        <span className="text-[10px] text-cohere-muted font-normal ml-1">(@ ₹{pulpHoldingCostRate}/kg/mo)</span>
                      </div>
                    </div>

                    <div className="p-2.5 rounded-xs bg-cohere-panel/50 border border-cohere-border">
                      <div className="text-[10px] font-mono text-cohere-muted">HISTORICAL EMERGENCY AIR FREIGHT</div>
                      <div className="text-base font-semibold font-mono text-scm-critical mt-0.5">
                        ₹{(pulpTimeline?.financial_comparison.historical_air_freight_reference_inr_cr ?? 3.20).toFixed(2)} Cr
                        <span className="text-[10px] text-cohere-muted font-normal ml-1">(Case Baseline)</span>
                      </div>
                    </div>
